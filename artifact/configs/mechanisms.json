      "V_pair": "accuracy(method,paired)-mean_replica_accuracy(method,permuted)",
      "identity": "V_total=V_perm+V_pair",
      "reference_baseline_by_method": {
        "default": "naive_sgd",
        "mer": "mer_current_only"
      }
